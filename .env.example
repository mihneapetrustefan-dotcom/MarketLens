# MarketLens — environment template
# ---------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored; this file is not,
# so it must never contain a real value.
#
# NOTHING HERE IS READ FROM A FILE AUTOMATICALLY. The project reads
# `os.environ`, so export these in your shell, or use the GitHub
# Actions secret store in CI. This file documents WHICH variables
# exist — it is not loaded.

# ===============================================================
# Market data providers (Phases 1-12)
# ===============================================================
POLYGON_API_KEY=<configured-securely>
FINNHUB_API_KEY=<configured-securely>
ALPHA_VANTAGE_API_KEY=<configured-securely>
FRED_API_KEY=<configured-securely>

# ===============================================================
# Alerting
# ===============================================================
SMTP_HOST=<configured-securely>
SMTP_PORT=<configured-securely>
SMTP_USERNAME=<configured-securely>
SMTP_PASSWORD=<configured-securely>
ALERT_EMAIL_TO=<configured-securely>

# ===============================================================
# Execution safety (Phase 14)
# ===============================================================
# Read ONLY so the system can report that someone set it. It changes
# nothing: no real-money adapter exists in this repository, and none
# can be enabled by configuration.
MARKETLENS_ALLOW_REAL_ORDERS=false

# ===============================================================
# Interactive Brokers (Phase 15)
# ===============================================================
#
# THERE IS NO IBKR USERNAME OR PASSWORD VARIABLE HERE, AND THAT IS
# DELIBERATE.
#
# This project uses the IBKR Client Portal Web API. The Client Portal
# Gateway — a small Java program you run yourself — authenticates you
# in a browser and holds the session. The application talks to that
# gateway over localhost and never sees your credential.
#
# If you find yourself wanting to add IBKR_USERNAME or IBKR_PASSWORD
# here, something has gone wrong: no code in this repository reads
# them, and adding them would create the exposure the transport choice
# was made to avoid.

# Master switch. With this false, the adapter is registered, visible
# and inert.
IBKR_ENABLED=false

# Only 'paper' is accepted. 'live' is refused at construction.
IBKR_ENVIRONMENT=paper

# Your IBKR PAPER account id. Paper accounts begin with DU; a live
# account begins with U and must not be used in this phase.
IBKR_ACCOUNT_ID=DU0000000

# Where the Client Portal Gateway is listening. Its own default is
# https://localhost:5000/v1/api.
IBKR_HOST=localhost
IBKR_PORT=5000
IBKR_BASE_PATH=/v1/api

# The gateway serves a self-signed certificate on localhost, so
# verification is off by default. It CANNOT be off for a non-local
# host — the configuration refuses that combination.
IBKR_VERIFY_TLS=false

IBKR_TIMEOUT_SECONDS=15
IBKR_RECONNECT_ENABLED=true
IBKR_MAX_RETRIES=5
IBKR_MAX_REQUESTS_PER_MINUTE=50

# THE SECOND GATE. Connecting to IBKR is not permission to trade.
# Leave this false until you have confirmed, in the IBKR web portal,
# that IBKR_ACCOUNT_ID above is a PAPER account.
IBKR_PAPER_ORDERING_ENABLED=false
